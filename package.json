{
  "name": "@yanghx/dsh-quick-notes",
  "version": "0.2.0",
  "type": "module",
  "description": "随手记：⌘⇧N 速记浮层 + 按天时间线 + 本地 Markdown（多笔记本）",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
